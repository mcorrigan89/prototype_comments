{
  "name": "prototype-comments",
  "version": "0.1.0",
  "description": "Drop-in, Figma-style comments for static frontend prototypes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.server.config.ts",
    "build:client": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "preview": "npm run build && node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "node scripts/worker-dev-vars.mjs && wrangler dev --port 8788",
    "worker:deploy": "wrangler deploy",
    "worker:secrets": "node scripts/cloudflare-secrets.mjs",
    "lambda:local": "npm run build:server && node scripts/lambda-local.mjs",
    "lambda:deploy": "node scripts/lambda-deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
