# Copy to .env. With nothing set, `npm run dev` uses fake Notion and fake sign-in.

# --- Notion: the internal integration that reads and writes the feedback databases ---
# notion.so/profile/integrations → New integration → Internal.
# Capabilities: Read content, Update content, Insert content, Read comments,
# Insert comments, Read user information including email addresses.
NOTION_TOKEN=
# The hub page that holds every prototype's feedback database (link or id).
# Connect the integration to it: page menu → Connections → add the integration.
# Script tags may only point at databases inside this page.
NOTION_HUB_PAGE_ID=

# --- Notion: the public integration used only for "Sign in with Notion" ---
# notion.so/profile/integrations → New integration → Public.
# Redirect URI: <your API URL>/auth/callback (locally: http://localhost:8787/auth/callback).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Backend ---
# Signs session tokens. Any long random string: `openssl rand -base64 32`.
# Changing it signs everyone out. Optional locally, required on Lambda.
SESSION_SECRET=
# Comma-separated origins of the prototypes (scheme://host[:port], no path).
# Locally defaults to http://localhost:5173,http://localhost:4173.
ALLOWED_ORIGINS=
# Comma-separated feedback database links/ids whose comments need sign-in to view.
PRIVATE_DATABASES=
# Optional: this API's public URL, if it can't be derived from the request.
PUBLIC_URL=
# Optional: how long a sign-in lasts, in days (default 30).
SESSION_DAYS=
