# Copy to .env. With nothing set, `npm run dev` uses fake Notion and fake sign-in.

# --- Notion: the internal integration that reads and writes comments ---
# app.notion.com/developers/connections → new Internal connection (see AGENTS.md).
# Then, for each prototype's Notion page: ••• → Connections → add this connection.
# Capabilities: Read content, Update content, Insert content, Read comments,
# Insert comments, Read user information including email addresses.
NOTION_TOKEN=

# --- Notion: the public integration used only for "Sign in with Notion" ---
# Optional locally: without it, `npm run dev` shows a pick-a-person page listing
# your workspace's real members. Required when deployed.
# app.notion.com/developers/connections → new OAuth connection, this workspace only.
# Redirect URI: <your API URL>/auth/callback (locally: http://localhost:8787/auth/callback).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Backend ---
# Signs session tokens. Any long random string: `openssl rand -base64 32`.
# Changing it signs everyone out. Optional locally, required when deployed.
SESSION_SECRET=
# Comma-separated origins of the prototypes (scheme://host[:port], no path).
# `*` matches one part of a hostname, e.g. http://govwell-*-prototype.s3-website.us-east-2.amazonaws.com
# Locally defaults to http://localhost:5173,http://localhost:4173.
ALLOWED_ORIGINS=
# Comma-separated prototype page links/ids whose comments need sign-in to view.
PRIVATE_DATABASES=
# Optional: this API's public URL, if it can't be derived from the request.
PUBLIC_URL=
# Optional: how long a sign-in lasts, in days (default 30).
SESSION_DAYS=
