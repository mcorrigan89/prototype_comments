// Cloudflare Workers config for the backend. Deploy with `npm run worker:deploy`.
// Secrets (NOTION_TOKEN, NOTION_CLIENT_ID, NOTION_CLIENT_SECRET, SESSION_SECRET) are NOT here:
// upload them with `npm run worker:secrets`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prototype-comments",
  "main": "server/src/worker.ts",
  "compatibility_date": "2026-10-01",
  // node:crypto (HMAC session tokens) and Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Origins of the prototypes allowed to use the backend and receive sign-in tokens, comma-separated.
    // `*` matches one part of a hostname (never a dot). Anyone can create an S3 bucket whose name fits
    // the pattern, so this trusts the naming convention; a domain you own would close that gap.
    // localhost:5173 lets prototypes use Notion comments from their Vite dev server.
    "ALLOWED_ORIGINS": "http://govwell-*-prototype.s3-website.us-east-2.amazonaws.com,https://mcorrigan89.github.io,http://localhost:5173,http://127.0.0.1:5173",
    "PRIVATE_DATABASES": ""
  }
}
